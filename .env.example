# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL
DATABASE_URL=

# AWS credentials / region
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# S3 (permit PDF storage)
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_PREFIX=
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_ENDPOINT_URL=
AWS_S3_PRESIGN_EXPIRES=

# Textract (OCR)
TEXTRACT_REGION=
TEXTRACT_ASYNC_TIMEOUT=200
TEXTRACT_ASYNC_POLL_INTERVAL=2
TEXTRACT_ASYNC_POLL_MAX=8

# Bedrock (LLM field extraction)
BEDROCK_MODEL_ID=
BEDROCK_REGION=
BEDROCK_DEBUG_JSON=0

# SES (email notifications)
SES_FROM_EMAIL=
